{
  "name": "cv-pilot",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "agent:dev": "eve dev",
    "agent:build": "eve build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc",
    "test:browser": "node tests/browser-qa.mjs"
  },
  "dependencies": {
    "@vercel/connect": "^2.8.0",
    "ai": "^7.0.137",
    "eve": "^1.0.0-rc.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "playwright-core": "^1.64.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}